// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy Tab 3 Lite 7.0 Wi-Fi (SM-T110 / goyawifi) Device Tree
 *
 * SoC: Marvell PXA986 (PXA988 family, dual Cortex-A9 r3p0)
 * RAM: 1 GiB LPDDR2 @ 0x00000000
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/thermal/thermal.h>
#include "pxa988.dtsi"
#include "pxa986-samsung-goyawifi-pins.dtsi"

/ {
	model = "Samsung Galaxy Tab 3 Lite 7.0 (SM-T110)";
	compatible = "samsung,goyawifi", "marvell,pxa986", "marvell,pxa988";

	aliases {
		i2c1 = &twsi1;
		i2c2 = &twsi2;
		i2c5 = &sensor_i2c;
		i2c6 = &charger_i2c;
		i2c7 = &muic_i2c;
		mmc0 = &sdh3;
		mmc1 = &sdh1;
		mmc2 = &sdh2;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		bootargs = "console=ttyS0,115200 console=tty0 earlyprintk panic=10";
		stdout-path = "serial0:115200n8";

		framebuffer0: framebuffer@17000000 {
			compatible = "simple-framebuffer";
			reg = <0x17000000 (1024 * 600 * 4)>;
			width = <1024>;
			height = <600>;
			stride = <4096>;
			format = "a8r8g8b8";
			status = "disabled";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x40000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * 0x00000000..0x000fffff: Marvell OBM / secure boot ROM area
		 * (covered by TEXT_OFFSET = 0x00108000, reserved as no-map).
		 */
		obm_reserved: obm@0 {
			reg = <0x00000000 0x00100000>;
			no-map;
		};

		/*
		 * 0x06000000..0x080fffff: CP / MSA carveout (32 MiB) +
		 * 1 MiB OBM / shared parameter page at 0x08000000 (HW-protected).
		 */
		cp_reserved: cp@6000000 {
			reg = <0x06000000 0x02100000>;
			no-map;
		};

		/*
		 * 0x08100000..0x0817ffff: ramoops / persistent_ram (512 KiB).
		 *
		 * With record-size = <0> and console-size = <0x00040000>,
		 * Linux 4.19 places the 256 KiB RS8-ECC console ring buffer
		 * right at 0x08100000 with signature 0x43474244 ("DBGC"),
		 * matching TWRP recovery's /proc/last_kmsg reader byte-for-byte.
		 */
		ramoops: ramoops@8100000 {
			compatible = "ramoops";
			reg = <0x08100000 0x00080000>;
			record-size = <0>;
			console-size = <0x00040000>;
			ftrace-size = <0x00020000>;
			pmsg-size = <0x00020000>;
			ecc-size = <16>;
			unbuffered;
			no-map;
		};

		/*
		 * 96 MiB shared reusable CMA pool in 0x20000000..0x2fffffff
		 * (lowmem) for DRM scanout, GPU, camera, and VPU buffers.
		 */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x06000000>;
			alignment = <0x00100000>;
			alloc-ranges = <0x20000000 0x10000000>;
			linux,cma-default;
		};
	};

	panel_lcd_3v3: regulator-panel-lcd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "panel_lcd_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio 9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	panel: panel {
		compatible = "boe,ba070ws1-400", "panel-lvds";
		width-mm = <154>;
		height-mm = <90>;
		data-mapping = "vesa-24";
		power-supply = <&panel_lcd_3v3>;

		panel-timing {
			clock-frequency = <51919000>;
			hactive = <1024>;
			vactive = <600>;
			hfront-porch = <123>;
			hsync-len = <120>;
			hback-porch = <100>;
			vfront-porch = <13>;
			vsync-len = <10>;
			vback-porch = <10>;
			hsync-active = <1>;
			vsync-active = <1>;
		};

		port {
			panel_in_lvds: endpoint {
				remote-endpoint = <&vx5b3d_out_panel>;
			};
		};
	};

	/* Bit-banged I2C buses */
	camera_i2c: i2c-camera {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 54 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 53 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;	/* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_camera_pins>;
		status = "okay";

		sensor@20 {
			compatible = "siliconfile,sr200pc20m";
			reg = <0x20>;
			clocks = <&ccic>;
			io-enable-gpios = <&gpio 79 GPIO_ACTIVE_HIGH>;
			analog-enable-gpios = <&gpio 80 GPIO_ACTIVE_HIGH>;
			standby-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
			reset-gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&camera_pins>;

			port {
				sensor_out: endpoint {
					remote-endpoint = <&ccic_in>;
					clock-lanes = <0>;
					data-lanes = <1>;
				};
			};
		};
	};

	sensor_i2c: i2c-sensor {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 36 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 35 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;	/* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_sensor_pins>;
		status = "okay";

		accelerometer@18 {
			compatible = "bosch,bma255";
			reg = <0x18>;
			pinctrl-names = "default";
			pinctrl-0 = <&accel_pins>;
			interrupt-parent = <&gpio>;
			interrupts = <10 IRQ_TYPE_EDGE_RISING>;
			mount-matrix = "0", "1", "0",
				       "1", "0", "0",
				       "0", "0", "-1";
		};
	};

	charger_i2c: i2c-charger {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;	/* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_charger_pins>;
		status = "okay";

		charger: charger@34 {
			compatible = "summit,smb328";
			reg = <0x34>;
			pinctrl-names = "default";
			pinctrl-0 = <&charger_pins>;
			interrupt-parent = <&gpio>;
			interrupts = <8 IRQ_TYPE_EDGE_FALLING>;
			enable-gpios = <&gpio 98 GPIO_ACTIVE_LOW>;
			extcon = <&muic>;
			monitored-battery = <&battery>;
			summit,dcp-input-current-microamp = <500000>;
			summit,fast-charge-current-microamp = <500000>;
			summit,float-voltage-microvolt = <4320000>;
		};
	};

	muic_i2c: i2c-muic {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 50 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 49 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;	/* ~100 kHz */
		#address-cells = <1>;
		#size-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_muic_pins>;
		status = "okay";

		muic: muic@14 {
			compatible = "richtek,rt8973a-muic";
			reg = <0x14>;
			pinctrl-names = "default";
			pinctrl-0 = <&muic_pins>;
			interrupt-parent = <&gpio>;
			interrupts = <93 IRQ_TYPE_EDGE_FALLING>;
		};
	};

	wifi_pwrseq: wifi-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio 51 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <20>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&gpio_keys_pins &home_key_pins>;

		volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};

		volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpio 2 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
		};

		home {
			label = "Home";
			linux,code = <KEY_HOME>;
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
			debounce-interval = <30>;
			wakeup-source;
		};
	};
};

/* MFPR Pin Controller */
&pmx {
	status = "okay";
};

/* GPIO Controller */
&gpio {
	status = "okay";
};

/* Peripheral DMA */
&pdma0 {
	status = "okay";
};

/* Audio SRAM TDMA */
&adma0 {
	status = "okay";
};

/* Debug UART (UART1 -> ttyS0) */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "okay";
};

/* GPS UART (UART2 -> ttyS1) */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	status = "okay";
};

/* Shared Touchscreen & Display Bridge I2C Bus */
&twsi1 {
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&twsi1_pins>;
	pinctrl-1 = <&twsi1_gpio_pins>;
	scl-gpios = <&gpio 87 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	sda-gpios = <&gpio 88 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
	mrvl,i2c-fast-mode;
	status = "okay";

	touchscreen@20 {
		compatible = "zinitix,bt532";
		reg = <0x20>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_pins>;
		interrupt-parent = <&gpio>;
		interrupts = <94 IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&ldo1>;
		vcca-supply = <&ldo1>;
		touchscreen-size-x = <600>;
		touchscreen-size-y = <1024>;
		zinitix,mode = <0>;
		linux,keycodes = <KEY_RESERVED KEY_MENU KEY_BACK KEY_RESERVED>;
	};

	vx5b3d@64 {
		compatible = "quicklogic,vx5b3d";
		reg = <0x64>;
		pinctrl-names = "default";
		pinctrl-0 = <&display_pins>;
		vdd12-supply = <&ldo12>;
		vdd18-supply = <&ldo9>;
		enable-gpios = <&gpio 19 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
		backlight-enable-gpios = <&gpio 12 GPIO_ACTIVE_HIGH>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				vx5b3d_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_vx5b3d>;
				};
			};

			port@1 {
				reg = <1>;
				vx5b3d_out_panel: endpoint {
					remote-endpoint = <&panel_in_lvds>;
				};
			};
		};
	};
};

/* Dedicated PMIC & Audio Codec I2C Bus */
&twsi2 {
	status = "okay";

	pmic: pmic@30 {
		compatible = "marvell,88pm822", "marvell,88pm800";
		reg = <0x30>;
		interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-parent = <&gic>;

		regulators {
			compatible = "marvell,88pm822-regulator", "marvell,88pm80x-regulator";

			buck1: buck1 {
				regulator-name = "vcc_main";
				/* Shared CPU/DDR/GPU/CP floor: 1175 mV (VL2) */
				regulator-min-microvolt = <1175000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck2: buck2 {
				regulator-name = "v_buck2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck3: buck3 {
				regulator-name = "v_buck3";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck4: buck4 {
				regulator-name = "v_buck4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: buck5 {
				regulator-name = "v_buck5";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3950000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: ldo1 {
				regulator-name = "v_tsp_3v3";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-enable-ramp-delay = <15000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo2: ldo2 {
				regulator-name = "v_ldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo3: ldo3 {
				regulator-name = "v_mem_a_2v8";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: ldo4 {
				regulator-name = "v_sd_3v3";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: ldo5 {
				regulator-name = "v_mmc_3v3";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo6: ldo6 {
				regulator-name = "v_ldo6";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo7: ldo7 {
				regulator-name = "v_ldo7";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo8: ldo8 {
				regulator-name = "v_ldo8";
				regulator-min-microvolt = <3100000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo9: ldo9 {
				regulator-name = "v_ldo9";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo10: ldo10 {
				regulator-name = "v_wib_3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			ldo11: ldo11 {
				regulator-name = "v_ldo11";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo12: ldo12 {
				regulator-name = "v_ldo12";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo13: ldo13 {
				regulator-name = "v_ldo13";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo14: ldo14 {
				regulator-name = "v_ldo14";
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-boot-on;
				regulator-always-on;
			};

			voutsw: voutsw {
				regulator-name = "v_buck2_sw";
				regulator-boot-on;
				regulator-always-on;
			};
		};

		rtc {
			compatible = "marvell,88pm822-rtc", "marvell,88pm80x-rtc";
		};

		onkey {
			compatible = "marvell,88pm822-onkey", "marvell,88pm80x-onkey";
		};

		gpadc {
			compatible = "marvell,88pm822-gpadc";
		};

		battery: battery {
			compatible = "marvell,88pm822-battery";
			power-supplies = <&charger>;
		};
	};

	pm805: codec@38 {
		compatible = "marvell,88pm805";
		reg = <0x38>;
		marvell,pmic = <&pmic>;
		micbias-supply = <&ldo14>;
	};
};

/* ChipIdea USB 2.0 Device Controller */
&usb {
	extcon = <&muic>;
	force-vbus;
	status = "okay";
};

/* eMMC Internal Storage (SanDisk 8GB) */
&sdh3 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdh3_emmc_pins>;
	bus-width = <8>;
	non-removable;
	no-sd;
	no-sdio;
	no-1-8-v;
	max-frequency = <26000000>;
	assigned-clocks = <&soc_clocks PXA988_CLK_SDH2>;
	assigned-clock-rates = <52000000>;
	mrvl,clk-delay-cycles = <15>;
	status = "okay";
};

/* microSD Card Slot (CD600) */
&sdh1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdh1_pins>;
	bus-width = <4>;
	cd-gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
	cd-debounce-delay-ms = <200>;
	disable-wp;
	vmmc-supply = <&ldo4>;
	vqmmc-supply = <&ldo5>;
	cap-sd-highspeed;
	no-1-8-v;
	max-frequency = <50000000>;
	assigned-clocks = <&soc_clocks PXA988_CLK_SDH0>;
	assigned-clock-rates = <52000000>;
	status = "okay";
};

/* Marvell 88W8777 SDIO Wi-Fi / Bluetooth */
&sdh2 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdh2_wlan_pins &wlan_bt_ctrl_pins &wlan_wake_pins>;
	bus-width = <4>;
	non-removable;
	no-sd;
	no-mmc;
	no-1-8-v;
	cap-sdio-irq;
	keep-power-in-suspend;
	vmmc-supply = <&ldo10>;
	mmc-pwrseq = <&wifi_pwrseq>;
	max-frequency = <26000000>;
	assigned-clocks = <&soc_clocks PXA988_CLK_SDH1>;
	assigned-clock-rates = <52000000>;
	mrvl,clk-delay-cycles = <15>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	mwifiex: wifi@1 {
		compatible = "marvell,sd8777";
		reg = <1>;
		interrupt-parent = <&gpio>;
		interrupts = <84 IRQ_TYPE_EDGE_FALLING>;
		marvell,wakeup-pin = <9>;
	};
};

/* Full KMS + MIPI DSI -> VX5B3D -> LVDS Panel Display Pipeline */
&dsi {
	status = "okay";

	ports {
		port@1 {
			reg = <1>;
			dsi_out_vx5b3d: endpoint {
				remote-endpoint = <&vx5b3d_in_dsi>;
			};
		};
	};
};

&ccic {
	status = "okay";

	port {
		ccic_in: endpoint {
			remote-endpoint = <&sensor_out>;
			clock-lanes = <0>;
			data-lanes = <1>;
		};
	};
};

&lcd {
	status = "okay";
};

&gc_power {
	power-supply = <&buck1>;
	status = "okay";
};

&gpu {
	status = "okay";
};

&vpu_power {
	power-supply = <&buck1>;
	status = "okay";
};

&vpu {
	status = "okay";
};

&thermal {
	status = "okay";
};

&ssp1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2s_pins>;
	status = "okay";
};

&ssp_dai1 {
	status = "okay";
};

&mmp_pcm {
	status = "okay";
};

/ {
	sound: sound@d4050044 {
		compatible = "marvell,pxa-88pm805-snd-card";
		reg = <0xd4050044 0x4>;
		cpu-dai = <&ssp_dai1>;
		audio-codec = <&pm805>;
		platform = <&mmp_pcm>;
	};

	thermal-zones {
		cpu_thermal: cpu-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;
			thermal-sensors = <&thermal>;

			trips {
				cpu_alert0: trip-point0 {
					temperature = <85000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_alert1: trip-point1 {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "passive";
				};

				cpu_crit: trip-point2 {
					temperature = <110000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&cpu_alert0>;
					cooling-device = <&cpu0 1 2>;
				};

				map1 {
					trip = <&cpu_alert1>;
					cooling-device = <&cpu0 2 THERMAL_NO_LIMIT>;
				};
			};
		};
	};

	cpu_opp_table: opp-table-cpu {
		compatible = "operating-points-v2";
		opp-shared;

		opp-312000000 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <1175000 1175000 1400000>;
			clock-latency-ns = <100000>;
		};

		opp-624000000 {
			opp-hz = /bits/ 64 <624000000>;
			opp-microvolt = <1175000 1175000 1400000>;
			clock-latency-ns = <100000>;
		};

		opp-1066000000 {
			opp-hz = /bits/ 64 <1066000000>;
			opp-microvolt = <1175000 1175000 1400000>;
			clock-latency-ns = <100000>;
		};

		opp-1204666667 {
			opp-hz = /bits/ 64 <1204666667>;
			opp-microvolt = <1275000 1275000 1400000>;
			clock-latency-ns = <100000>;
		};
	};

	ddr_opp_table: opp-table-ddr {
		compatible = "operating-points-v2";

		opp-312000000 {
			opp-hz = /bits/ 64 <312000000>;
			opp-microvolt = <1175000 1175000 1400000>;
		};

		opp-533000000 {
			opp-hz = /bits/ 64 <533000000>;
			opp-microvolt = <1275000 1275000 1400000>;
		};
	};

	ddr_devfreq: ddr@c0100000 {
		compatible = "marvell,pxa988-ddr";
		reg = <0xc0100000 0x1000>;
		clocks = <&soc_clocks PXA988_CLK_DDR>;
		ddr-supply = <&buck1>;
		operating-points-v2 = <&ddr_opp_table>;
	};
};

&cpu0 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&buck1>;
};

&cpu1 {
	operating-points-v2 = <&cpu_opp_table>;
	cpu-supply = <&buck1>;
};

&watchdog {
	status = "okay";
};
