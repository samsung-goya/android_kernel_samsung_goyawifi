config DRM_MMP
	tristate "DRM Support for Marvell PXA988/MMP Display Controller"
	depends on DRM && OF
	depends on ARCH_MMP || ARCH_MULTI_V7 || COMPILE_TEST
	select DRM_KMS_HELPER
	select DRM_KMS_CMA_HELPER
	select DRM_MIPI_DSI
	select DRM_PANEL
	select DRM_PANEL_BRIDGE
	select VIDEOMODE_HELPERS
	help
	  Choose this option if you have a Marvell PXA988/PXA986/MMP SoC
	  display controller with atomic KMS and MIPI DSI support.

	  If M is selected the module will be called mmp-drm.
